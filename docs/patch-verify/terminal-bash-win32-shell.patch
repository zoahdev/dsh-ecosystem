+/**
+ * Windows cannot resolve POSIX-style `/bin/bash`: CreateProcess does not
+ * PATH-search slash-prefixed paths, and node-pty passes argv[0] through
+ * unchanged (discussion #1856). When the default shellPath is still the
+ * POSIX default, probe the locations Git for Windows and WSL use.
+ */
+function winBashFallback(): string | undefined {
+  const candidates: string[] = []
+  const sep = process.platform === 'win32' ? ';' : ':'
+  for (const dir of (process.env.PATH ?? '').split(sep)) {
+    if (dir !== '') candidates.push(join(dir, 'bash.exe'), join(dir, 'bash'))
+  }
+  for (const root of [process.env.ProgramFiles, process.env['ProgramFiles(x86)'], process.env.LOCALAPPDATA]) {
+    if (root !== undefined) {
+      candidates.push(join(root, 'Git', 'bin', 'bash.exe'), join(root, 'Programs', 'Git', 'bin', 'bash.exe'))
+    }
+  }
+  for (const candidate of candidates) {
+    try { if (existsSync(candidate)) return candidate } catch { /* unreadable */ }
+  }
+  return undefined
+}
+
+function resolveShellPath(config: ResolvedConfig): string {
+  if (process.platform !== 'win32' || config.shellPath !== '/bin/bash') return config.shellPath
+  const resolved = winBashFallback()
+  if (resolved !== undefined) return resolved
+  throw new Error(
+    'terminal-bash: default shellPath /bin/bash cannot resolve on Windows. Install Git for Windows or WSL, '
+    + "or set terminal-bash.shellPath to an absolute bash.exe path (discussion #1856).",
+  )
+}
