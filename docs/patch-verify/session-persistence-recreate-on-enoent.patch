-    if (typeof ResizeObserver !== 'undefined' && panel !== null) {
-      observer = new ResizeObserver(place)
-      observer.observe(panel)
-    }
-    return () => {
-      observer?.disconnect()
-      window.removeEventListener('scroll', place, true)
-      window.removeEventListener('resize', place)
