-function batches(events: readonly SessionEvent[], sizes: readonly number[]): SessionEvent[][] {
-  const result: SessionEvent[][] = []
-  let offset = 0
-  let index = 0
-  while (offset < events.length) {
-    const size = sizes[index % sizes.length] as number
