-function block(selector: string): string {
-  const match = new RegExp(`^\\${selector} \\{([^}]*)\\}`, 'm').exec(css)
-  if (match === null) throw new Error(`MessageFeedbackActions.module.css has no \`${selector}\` rule`)
-  return match[1] ?? ''
-}
