-  }
-  const decoded = parseCurrentTeamEvent(event)
-  if (decoded.data.teamId !== state.id) return
-
-  switch (decoded.type) {
-    case 'team/member': {
-      const member = decoded.data.member
-      const prior = state.members.get(member.id)
