-    case 'team/message/delivered':
-      return { ...event, data: parsePersisted(event.type, teamMessageDeliveredEventSchema, event.data) }
-    /* v8 ignore next 2 -- TeamEventType is closed and every member is handled above. */
-    default:
-      return event
-  }
-}
-
