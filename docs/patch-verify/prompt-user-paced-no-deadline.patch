+      await Promise.all([vi.advanceTimersByTimeAsync(30_001), assertion])
+      expect(timeoutSpy).not.toHaveBeenCalled()
+    } finally {
+      timeoutSpy.mockRestore()
+      vi.useRealTimers()
+    }
+  })
